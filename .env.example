# Copy this file to .env and fill in the values.

OPENAI_API_KEY=
APIFY_TOKEN=

# Supabase PostgreSQL connection string.
# Use the Session pooler connection string for serverless deployments,
# or the direct connection string for a long-running backend.
# Keep the postgresql+psycopg2:// driver prefix for SQLAlchemy.
SUPABASE_DB_URL=postgresql+psycopg2://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=workflow-automation
